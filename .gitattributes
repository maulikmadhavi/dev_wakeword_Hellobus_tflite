# Git LFS Configuration for Large Model and Data Files

# TensorFlow Model Files
*.pb filter=lfs diff=lfs merge=lfs -text
*.tflite filter=lfs diff=lfs merge=lfs -text
*.ckpt filter=lfs diff=lfs merge=lfs -text
*.ckpt.meta filter=lfs diff=lfs merge=lfs -text
*.ckpt.index filter=lfs diff=lfs merge=lfs -text
*.ckpt.data-00000-of-00001 filter=lfs diff=lfs merge=lfs -text
# NumPy and Data Files
*.npz filter=lfs diff=lfs merge=lfs -text
*.npy filter=lfs diff=lfs merge=lfs -text
# Compressed Data Archives
*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
# TensorFlow Event Files
events.out.tfevents.* filter=lfs diff=lfs merge=lfs -text
# Audio Dataset Archives
*.tar filter=lfs diff=lfs merge=lfs -text
*.ckpt* filter=lfs diff=lfs merge=lfs -text
